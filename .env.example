# Local development only. Do not reuse these credentials in production.
POSTGRES_DB=copilot
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot_local_only
# Used by the Vite server, not exposed to browser JavaScript.
BACKEND_URL=http://localhost:8000
# Backend settings. CORS is a JSON array because pydantic-settings parses complex values as JSON.
APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:5173"]
# Local backend URL; Compose supplies its own URL using POSTGRES_* above.
# URL-encode special characters in credentials when constructing a database URL.
APP_DATABASE_URL=postgresql+psycopg://copilot:copilot_local_only@localhost:5432/copilot
# Server-side only. Keep the real key in .env, never in VITE_* or Git.
OPENAI_API_KEY=
APP_OPENAI_MODEL=gpt-5-mini
APP_OPENAI_TIMEOUT_SECONDS=20
APP_OPENAI_MAX_RETRIES=1
APP_OPENAI_MAX_OUTPUT_TOKENS=4096
APP_CHAT_DEADLINE_SECONDS=45

# Retrieval cutoff; calibrate on representative questions, not a probability.
APP_RAG_MIN_SIMILARITY=0.3
